.post-list
  padding: 0
  margin-top: 0

  .post-item
    margin-bottom: 1rem
    margin-left: 0
    list-style-type: none
    display: flex
    align-items: center

    a:hover
      text-decoration: underline

    .meta
      display: block
      margin-right: 16px
      min-width: 100px
      color: $color-meta
      font-size: 16px
#about
  p
    color: #3191d6
    font-size: 20px
    margin-top: 0
    margin-bottom: 0

@media (min-width: 480px)
  .post-list
    .post-item
      display: flex
      margin-bottom: 5px

      .meta
        text-align: left

.project-list
  padding: 0
  list-style: none

  .project-item
    margin-bottom: 5px
    p
      display: inline
